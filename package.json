  "description": "An always up-to-date, community-made Pokédex for PokéRogue — species, moves, abilities, biomes, items and more, extracted straight from the game's source.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crabyy/pokeroguedex.git"
  },
  "engines": {
