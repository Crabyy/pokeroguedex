{
  "manifest_version": 3,
  "name": "PokéRogue Dex",
  "version": "1.0.0",
  "description": "The always-up-to-date PokéRogue Dex in a slide-out panel on pokerogue.net. Toggle it with a keyboard shortcut you choose.",
  "homepage_url": "https://pokeroguedex.vercel.app",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PokéRogue Dex",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://pokerogue.net/*", "https://www.pokerogue.net/*"],
      "js": ["shortcut.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://pokeroguedex.vercel.app/*"],
      "js": ["shortcut.js", "frame.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pokeroguedex@crabyy.github.io",
      "update_url": "https://pokeroguedex.vercel.app/extension/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
